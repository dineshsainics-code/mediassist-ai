# GEMINI_API_KEY: Required for live Gemini AI Patient Assistant responses.
# Configure this in your environment or AI Studio Secrets panel.
# When omitted, the assistant runs in clearly labelled Demo Mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_PATH: Optional path to the persistent SQLite database file.
# Defaults to ./data/mediassist.db
DATABASE_PATH="./data/mediassist.db"

# PORT: Server port (default 3000)
PORT="3000"

# APP_URL: Public URL where this application is hosted.
APP_URL="http://localhost:3000"
